# ============================================================
# STAC Submission Portal - Environment Configuration
# ============================================================

# ------------------------------------------------------------
# REDCap API Configuration
# ------------------------------------------------------------
BASE_URL=https://redcap.example.edu/api/

# ------------------------------------------------------------
# REDCap API Token
# Used for Enrollment and UDSv4 form reports
# ------------------------------------------------------------
UDSV4_TOKEN=your_udsv4_token_here

# ------------------------------------------------------------
# REDCap Report IDs
# ------------------------------------------------------------
ENROLL_ID=12350
ENROLL_SUBS=12351

REPORT_ID_UDS=12345
REPORT_ID_M1=12346
REPORT_ID_CLS=12347
REPORT_ID_FTD=12348
REPORT_ID_LBD=12349
REPORT_ID_NPV11=12352

# ------------------------------------------------------------
# Flywheel Configuration
# ------------------------------------------------------------
FLYWHEEL_TOKEN=your_flywheel_token_here
FW_GROUP=your_flywheel_group
FW_PROJECT=your_submission_project
FW_ENROLL=your_enrollment_project

# ------------------------------------------------------------
# Flask / Docker Runtime
# ------------------------------------------------------------
NACC_FLASK_SECRET=replace_with_random_secret
NACC_JOB_ROOT=/var/lib/nacc-pipeline/jobs
NACC_RUNTIME_ROOT=/var/lib/nacc-pipeline/runtime
NACC_HOST=0.0.0.0
NACC_PORT=8000
NACC_WAITRESS_THREADS=4
NACC_MAX_UPLOAD_BYTES=5242880
NACC_LOG_LEVEL=INFO
NACC_DEPLOYMENT_ENV=production

# ------------------------------------------------------------
# Reverse Proxy Authentication
# ------------------------------------------------------------
NACC_TRUSTED_AUTH_ENABLED=0
NACC_TRUSTED_USER_HEADER=X-Remote-User
NACC_TRUST_PROXY_HEADERS=0
NACC_SESSION_COOKIE_SECURE=1
NACC_ENABLE_DEV_AUTH=0
